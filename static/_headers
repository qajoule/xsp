/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; font-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Permitted-Cross-Domain-Policies: none

# Link previews may load the OGP image from another origin. This rule must stay
# after /* because "! " only removes headers that earlier rules added.
/images/ogp.png
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

# The kuromoji dictionary keeps fixed names, so browsers revalidate it.
/vendor/*
  Cache-Control: public, no-cache

# Everything under /assets/ has a fingerprinted name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/legal/LICENSE
  Content-Type: text/plain; charset=utf-8

/legal/THIRD_PARTY_NOTICES.md
  Content-Type: text/plain; charset=utf-8
